# Postgres connection string. Works with Neon, Supabase, or any Postgres instance.
# Neon example: postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Supabase example: postgres://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orm_test

# Set to "false" only for local Postgres without TLS. Neon/Supabase always need "require" (the default).
DATABASE_SSL=false

# Optional: log every generated SQL statement.
DEBUG_SQL=false

PORT=3000
